/* pages/history/history.wxss */

.container {
  padding: 0;
  background: var(--bg-primary);
  min-height: 100vh;
}

/* 基金信息 */
.fund-info {
  background: var(--bg-secondary);
  padding: 32rpx 24rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.fund-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.fund-code {
  color: var(--primary-color);
  font-size: 36rpx;
  font-weight: 600;
  font-family: var(--font-mono);
}

.fund-name {
  color: var(--text-primary);
  font-size: 32rpx;
}

/* 时间范围 */
.time-range {
  display: flex;
  gap: 16rpx;
}

.range-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  background: var(--bg-tertiary);
  border-radius: 8rpx;
  color: var(--text-secondary);
  font-size: 28rpx;
  border: 1rpx solid var(--border-color);
  transition: all 0.3s;
}

.range-item.active {
  background: rgba(0, 212, 255, 0.2);
  color: var(--primary-color);
  border-color: var(--primary-color);
}

/* 图表区域 */
.chart-section {
  background: var(--bg-secondary);
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.chart-title {
  color: var(--text-primary);
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.chart-container {
  position: relative;
  width: 100%;
  height: 400rpx;
}

.chart-canvas {
  width: 100%;
  height: 100%;
}

.chart-tooltip {
  position: absolute;
  background: rgba(0, 0, 0, 0.8);
  border-radius: 8rpx;
  padding: 16rpx;
  pointer-events: none;
  z-index: 100;
}

.tooltip-date {
  color: var(--text-secondary);
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.tooltip-value {
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 600;
}

/* 统计信息 */
.stats-section {
  background: var(--bg-secondary);
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.stats-title {
  color: var(--text-primary);
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.stat-card {
  background: var(--bg-tertiary);
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
}

.stat-label {
  display: block;
  color: var(--text-muted);
  font-size: 24rpx;
  margin-bottom: 12rpx;
}

.stat-value {
  display: block;
  color: var(--text-primary);
  font-size: 36rpx;
  font-weight: 600;
  font-family: var(--font-mono);
}

.stat-date {
  display: block;
  color: var(--text-muted);
  font-size: 22rpx;
  margin-top: 8rpx;
  font-family: var(--font-mono);
}

/* 历史数据列表 */
.history-list {
  background: var(--bg-secondary);
  padding: 24rpx;
}

.list-title {
  color: var(--text-primary);
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.history-item {
  background: var(--bg-tertiary);
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.item-date {
  color: var(--primary-color);
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  font-family: var(--font-mono);
}

.item-data {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.data-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.data-label {
  color: var(--text-muted);
  font-size: 24rpx;
}

.data-value {
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 600;
  font-family: var(--font-mono);
}

/* 加载和空状态 */
.loading,
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: var(--text-muted);
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}
